{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devops-career-coach",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Cal.com or Calendly link shown at the end of every Report.
    "BOOKING_URL": "",
    // Public Turnstile site key; the secret is TURNSTILE_SECRET_KEY.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFb5fDsrkSy6myj8",
    "ANALYSES_PER_IP_PER_HOUR": "5",
    "DAILY_ANALYSIS_CAP": "30"
  },
  // Secrets (wrangler secret put): GEMINI_API_KEY, TURNSTILE_SECRET_KEY, PASS_SECRET.
  "ratelimits": [
    { "name": "ANALYSE_BURST", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "CHAT_BURST", "namespace_id": "1002", "simple": { "limit": 12, "period": 60 } }
  ],
  // Content-free counters only: the daily Analysis count and hashed-IP hourly hits.
  "durable_objects": {
    "bindings": [{ "name": "USAGE_GUARD", "class_name": "UsageGuard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageGuard"] }],
  // Logs carry content-free metadata only (see src/worker/log.ts).
  "observability": { "enabled": true },
  "env": {
    // Local end-to-end tests only (wrangler dev --env e2e): demo Gemini and
    // limits high enough for a test run. Never deployed.
    "e2e": {
      "vars": {
        "GEMINI_MODEL": "demo",
        "DEMO_GEMINI": "1",
        "BOOKING_URL": "https://example.com/book",
        "TURNSTILE_SITE_KEY": "",
        "ANALYSES_PER_IP_PER_HOUR": "1000",
        "DAILY_ANALYSIS_CAP": "1000",
        "METRICS_TOKEN": "e2e-operator-token"
      },
      "ratelimits": [
        { "name": "ANALYSE_BURST", "namespace_id": "2001", "simple": { "limit": 1000, "period": 60 } },
        { "name": "CHAT_BURST", "namespace_id": "2002", "simple": { "limit": 1000, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [{ "name": "USAGE_GUARD", "class_name": "UsageGuard" }]
      }
    }
  }
}
