{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devops-career-coach",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Cal.com or Calendly link shown at the end of every Report.
    "BOOKING_URL": ""
  },
  // Logs carry content-free metadata only (see src/worker/log.ts).
  "observability": { "enabled": true }
}
